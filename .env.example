# FINFLOW AI Configuration
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
# Configurable Gemini model (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
# When MOCK_MODE is True or GEMINI_API_KEY is empty, FINFLOW AI uses deterministic mock AI reasoning
MOCK_MODE=True
DB_PATH=database/finflow.db
